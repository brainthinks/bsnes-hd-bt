@@ -0,0 +1,31 @@
+namespace HdToolkit {
+  static constexpr auto determineWsExt(int ws, bool overscan, bool aspectCorrection) -> int {
+    double val = ws;
+    if (ws > 200) {
+      int w = ws / 100;
+      int h = ws % 100;
+      val = overscan ? 224.0 : 216.0;
+      val *= w;
+      val /= h;
+      if (aspectCorrection) {
+        val *= 7;
+        val /= 8;
+      }
+      if (val <= 256) {
+        return 0;
+      }
+      val -= 256;
+      val /= 2;
+    }
+    val /= 8;
+    if (overscan || aspectCorrection) {
+      val += 0.5;
+    }
+    ws = (int)val;
+    if (ws <= 0) {
+      return 0;
+    }
+    ws *= 8;
+    return ws;
+  }
+}
